# ==============================================================================
# Environment Configuration Template for Weather ETL Pipeline
# ==============================================================================

# Server Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Security (Set a strong secret key for protecting POST /trigger-etl)
API_SECRET_KEY=super-secret-etl-key-change-me

# ------------------------------------------------------------------------------
# Option A: Full Database URL (Recommended for Render, PlanetScale, AWS RDS)
# ------------------------------------------------------------------------------
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:password@mysql-instance.oregon-postgres.render.com:3306/weather_db

# ------------------------------------------------------------------------------
# Option B: Individual Database Credentials (Fallback if DATABASE_URL not set)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_password
DB_NAME=weather_db

# SSL Configuration (Set to REQUIRED for cloud hosts like Render/Aiven/AWS)
DB_SSL_MODE=PREFERRED
# DB_SSL_CA=/path/to/ca-certificate.crt

# ------------------------------------------------------------------------------
# ETL Pipeline Configuration
# ------------------------------------------------------------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=0.5
PAST_DAYS=1
FORECAST_DAYS=1

# Optional: Override default cities (JSON array format)
# CITIES_JSON=[{"name":"Tokyo","latitude":35.6762,"longitude":139.6503,"timezone":"UTC"},{"name":"London","latitude":51.5074,"longitude":-0.1278,"timezone":"UTC"}]
